{
  "name": "appium-agent-inspector",
  "version": "0.5.0",
  "description": "CLI daemon for AI-driven mobile UI inspection and automation via Appium",
  "keywords": [
    "appium",
    "mobile",
    "automation",
    "inspector",
    "ios",
    "android",
    "cli",
    "ai-agent",
    "webdriverio"
  ],
  "homepage": "https://github.com/AlexGalichenko/appium-agent-inspector#readme",
  "bugs": {
    "url": "https://github.com/AlexGalichenko/appium-agent-inspector/issues"
  },
  "type": "module",
  "bin": {
    "appium-agent": "dist/cli/index.js",
    "appium-daemon": "dist/daemon/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "Oleksandr Halchenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGalichenko/appium-agent-inspector.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "dev:daemon": "tsx watch src/daemon/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "webdriverio": "^9.31.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
