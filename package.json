{
  "name": "appium-agent-inspector",
  "version": "0.3.0",
  "description": "CLI daemon for AI-driven mobile UI inspection and automation via Appium",
  "keywords": [
    "appium",
    "mobile",
    "automation",
    "inspector",
    "ios",
    "android",
    "cli",
    "ai-agent",
    "webdriverio"
  ],
  "license": "MIT",
  "author": "Oleksandr Halchenko",
  "homepage": "https://github.com/AlexGalichenko/appium-agent-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGalichenko/appium-agent-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/AlexGalichenko/appium-agent-inspector/issues"
  },
  "type": "module",
  "bin": {
    "appium-agent": "dist/cli/index.js",
    "appium-daemon": "dist/daemon/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:daemon": "tsx watch src/daemon/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fastify": "^5.12.3",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "webdriverio": "^9.31.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.6.1",
    "appium-xcuitest-driver": "^12.12.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
